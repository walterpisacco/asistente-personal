# --- Database (app) ---
DATABASE_URL=mysql+pymysql://tori:toripass@localhost:3306/asistente_personal

# --- Bot conversacional (STT / TTS / LLM intercambiables) ---
BOT_ENABLED=true
#
BOT_GUEST_USER_ID=user_guest
BOT_WAKE_WORD=hola tori
# Wake local (VAD + keyword spotting). STT en la nube solo después de activar.
# La primera vez el bot descarga ~5 MB a backend/models/kws-es/
# BOT_KWS_THRESHOLD=0.25
# BOT_KWS_SCORE=1.0
# BOT_KWS_TRAILING_MS=1000
# BOT_WAKE_WINDOW_MS=2500
VOICE_ID_THRESHOLD=0.75

# google | mock | deepgram
STT_PROVIDER=deepgram

# google | elevenlabs | deepgram | mock
TTS_PROVIDER=deepgram

# openai | ollama | mock
LLM_PROVIDER=openai

BOT_GREETING=Hola
# immediate = saludo TTS ya | llm = espera saludo del modelo
BOT_OPENING_MODE=immediate
# Prompt largo: preferí archivo (no .env). Inline opcional pisa el archivo.
# BOT_SYSTEM_PROMPT=
BOT_SYSTEM_PROMPT_FILE=prompts/bot_system_prompt.txt
# Frases del bot → acciones (youtube_play, etc.). Archivo JSON o JSON inline.
BOT_ACTION_TRIGGERS_FILE=config/bot_action_triggers.json
# BOT_ACTION_TRIGGERS=[{"phrase":"pongo una canción","action":"youtube_play","target":"random"}]
# Espera 900 ms de silencio antes de STT (cambio de turno)
BOT_SILENCE_MS=900
# Silencio prolongado → fin de conversación
BOT_END_CALL_MS=10000
# Mínimo de voz para considerar que hubo una frase
BOT_MIN_SPEECH_MS=400
# Tope máximo de una captura (12000 ms = 12 s)
BOT_MAX_UTTERANCE_MS=12000
# Umbral de energía (RMS); más alto = menos sensible al ruido
BOT_VAD_ENERGY=400
# ms de audio previos al umbral VAD (evita perder la 1.ª palabra)
BOT_PREROLL_MS=700
BOT_SAMPLE_RATE=16000
# Pausa tras TTS antes de reabrir mic + settle anti-eco (como etiquetas-ia)
BOT_POST_TTS_DELAY_MS=500
BOT_MIC_SETTLE_MS=450

# Google Cloud (ruta al JSON de service account, relativo a backend/ o absoluto)
# Api Walter cuenta: wpisacco@gmail.com project: Indicadores

GOOGLE_CREDENTIAL=
GOOGLE_PROJECT_ID=
GOOGLE_API_KEY=
GOOGLE_BUCKET=
GOOGLE_STT_LANGUAGE=es-AR
GOOGLE_STT_MODEL=default
GOOGLE_TTS_LANGUAGE=es-US
GOOGLE_TTS_VOICE=es-US-Neural2-A
GOOGLE_TTS_SPEAKING_RATE=1.15
GOOGLE_LANGUAGE_CODE=es-AR
GOOGLE_LOCATION=global
GOOGLE_SAMPLE_RATE_HERTZ=8000

# -- Deepgram https://developers.deepgram.com/ / https://playground.deepgram.com/
DEEPGRAM_API_KEY=
DEEPGRAM_URL=https://api.deepgram.com
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=es-419
DEEPGRAM_VOICE=aura-2-celeste-es

# --- OpenAI cloud (LLM_PROVIDER=openai) ---
# Api Walter cuenta: wpisacco@gmail.com project: LLM Septiembre 2026 (expira 20 Oct/ limitada por IP)
OPENAI_API_KEY=

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TEMPERATURE=1.0
OPENAI_MAX_TOKENS=1000
OPENAI_TIMEOUT=60
#asistente Walter
#OPENAI_ASSISTANT_ID=asst_VV7GxKgp4WQVJ1SemH63BqPb
#asistente Dario
#OPENAI_ASSISTANT_ID=asst_Z58szvhCOAqaNfiKvovKGjri
OPENAI_ASSISTANT_ID=

# --- Ollama local (LLM_PROVIDER=ollama) ---
# ollama serve && ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
#OLLAMA_MODEL=qwen2.5:7b
OLLAMA_MODEL=gemma3:4b
OLLAMA_API_KEY=ollama
OLLAMA_TIMEOUT=120

# --- Call metrics (tracking en memoria + 1 INSERT MySQL al colgar) ---
CALL_METRICS_ENABLED=true
CALL_METRICS_MYSQL_HOST=
CALL_METRICS_MYSQL_PORT=3306
CALL_METRICS_MYSQL_USER=
CALL_METRICS_MYSQL_PASSWORD=
CALL_METRICS_MYSQL_DATABASE=
CALL_METRICS_PRICE_LLM_INPUT_PER_1M=0.40
CALL_METRICS_PRICE_LLM_OUTPUT_PER_1M=1.60

CALL_METRICS_PRICE_STT_PER_MINUTE=0.024

# 0.10 ElevenLabs / 0.016 Google Neural / 0.013 Deepgram
CALL_METRICS_PRICE_TTS_PER_1K_CHARS=0.013

