# --- Database (app) ---
DATABASE_URL=mysql+pymysql://tori:toripass@localhost:3306/asistente_personal

# --- Bot conversacional (STT / TTS / LLM intercambiables) ---
BOT_ENABLED=true
#
BOT_GUEST_USER_ID=user_guest
# Login: el bot pide usuario/contraseña (mismas credenciales que mobile/web).
# La sesión queda en backend/data/bot_session.json
# Wake local genérico tras el login (STT solo después de activar).
# La primera vez el bot descarga ~5 MB a backend/models/kws-es/
BOT_KWS_THRESHOLD=0.15
BOT_KWS_SCORE=1.5
BOT_KWS_TRAILING_MS=1200
BOT_WAKE_WINDOW_MS=3500
# BOT_WAKE_PHRASES=hola,hola tori,oye tori
# BOT_WAKE_TRACE=true
# BOT_MIC_INPUT_GAIN=0.35
VOICE_ID_THRESHOLD=0.75

# google | mock | deepgram
STT_PROVIDER=deepgram

# google | elevenlabs | deepgram | mock
TTS_PROVIDER=deepgram

# openai | ollama | mock
LLM_PROVIDER=openai

# pipeline = STT→LLM→TTS clásico | realtime = gpt-realtime speech-to-speech
CONVERSATION_MODE=realtime
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_REALTIME_SAMPLE_RATE=24000

BOT_GREETING=Hola
# immediate = saludo TTS ya | llm = espera saludo del modelo
BOT_OPENING_MODE=immediate
# Prompt largo: preferí archivo (no .env). Inline opcional pisa el archivo.
# BOT_SYSTEM_PROMPT=
BOT_SYSTEM_PROMPT_FILE=prompts/bot_system_prompt.txt
# Frases del bot → acciones (youtube_play, etc.). Archivo JSON o JSON inline.
BOT_ACTION_TRIGGERS_FILE=config/bot_action_triggers.json
# BOT_ACTION_TRIGGERS=[{"phrase":"pongo una canción","action":"youtube_play","target":"random"}]
# Espera 900 ms de silencio antes de STT (cambio de turno)
BOT_SILENCE_MS=900
# Silencio prolongado → fin de conversación
BOT_END_CALL_MS=10000
# Mínimo de voz para considerar que hubo una frase
BOT_MIN_SPEECH_MS=400
# Tope máximo de una captura (12000 ms = 12 s)
BOT_MAX_UTTERANCE_MS=12000
# Umbral de energía (RMS); más alto = menos sensible al ruido
BOT_VAD_ENERGY=400
# ms de audio previos al umbral VAD (evita perder la 1.ª palabra)
BOT_PREROLL_MS=700
BOT_SAMPLE_RATE=16000
# Pausa tras TTS antes de reabrir mic + settle anti-eco (como etiquetas-ia)
BOT_POST_TTS_DELAY_MS=500
BOT_MIC_SETTLE_MS=450
# UI idle (Echo): dominio local → 127.0.0.1 en /etc/hosts (ej. 127.0.0.1 tori.local)
# embed = video en el panel derecho; watch = YouTube a pantalla completa
BOT_UI_HOST=tori.local
BOT_UI_PORT=8765
BOT_UI_VIDEO_MODE=embed
# Tamaño ventana (0 = maximizada). Carrusel = 3/4 del ancho.
BOT_UI_WIDTH=1280
BOT_UI_HEIGHT=800

# Google Cloud (ruta al JSON de service account, relativo a backend/ o absoluto)
# Api Walter cuenta: wpisacco@gmail.com project: Indicadores

GOOGLE_CREDENTIAL=
GOOGLE_PROJECT_ID=
GOOGLE_API_KEY=
GOOGLE_BUCKET=
GOOGLE_STT_LANGUAGE=es-AR
GOOGLE_STT_MODEL=default
GOOGLE_TTS_LANGUAGE=es-US
GOOGLE_TTS_VOICE=es-US-Neural2-A
GOOGLE_TTS_SPEAKING_RATE=1.15
GOOGLE_LANGUAGE_CODE=es-AR
GOOGLE_LOCATION=global
GOOGLE_SAMPLE_RATE_HERTZ=8000

# -- Deepgram https://developers.deepgram.com/ / https://playground.deepgram.com/
DEEPGRAM_API_KEY=
DEEPGRAM_URL=https://api.deepgram.com
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=es-419
DEEPGRAM_VOICE=aura-2-celeste-es
# Aura-2 speed: 0.7–1.5 (es recomendado 0.9–1.5)
DEEPGRAM_SPEED=1.0

# Mini LLM que clasifica si el turno es una acción (JSON). Timeout en segundos.
INTENT_TIMEOUT_SECONDS=8

# CORS: lista de orígenes (no uses * en producción con credentials)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:5173

# --- Seguridad API ---
# Generá uno nuevo: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_TOKEN=change-me-generate-a-long-random-token
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_EXPENSIVE_PER_MINUTE=20
GEO_RESTRICT_ENABLED=false
GEO_RESTRICT_COUNTRIES=AR
GEO_ALLOW_PRIVATE=true
TRUST_PROXY_HEADERS=true

# --- Auth JWT (panel admin + mobile) ---
JWT_SECRET=change-me-jwt-secret-use-long-random
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=

# --- OpenAI cloud (LLM_PROVIDER=openai) ---
# Api Walter cuenta: wpisacco@gmail.com project: LLM Septiembre 2026 (expira 20 Oct/ limitada por IP)
OPENAI_API_KEY=

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TEMPERATURE=1.0
OPENAI_MAX_TOKENS=1000
OPENAI_TIMEOUT=60


# --- Ollama local (LLM_PROVIDER=ollama) ---
# ollama serve && ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
#OLLAMA_MODEL=qwen2.5:7b
OLLAMA_MODEL=gemma3:4b
OLLAMA_API_KEY=ollama
OLLAMA_TIMEOUT=120

# --- Call metrics (tracking en memoria + 1 INSERT MySQL al colgar) ---
CALL_METRICS_ENABLED=true
CALL_METRICS_MYSQL_HOST=
CALL_METRICS_MYSQL_PORT=3306
CALL_METRICS_MYSQL_USER=
CALL_METRICS_MYSQL_PASSWORD=
CALL_METRICS_MYSQL_DATABASE=
# Pipeline (STT/LLM/TTS clásicos)
CALL_METRICS_PRICE_LLM_INPUT_PER_1M=0.40
CALL_METRICS_PRICE_LLM_OUTPUT_PER_1M=1.60
CALL_METRICS_PRICE_STT_PER_MINUTE=0.024
# 0.10 ElevenLabs / 0.016 Google Neural / 0.013 Deepgram
CALL_METRICS_PRICE_TTS_PER_1K_CHARS=0.013

# Realtime gpt-realtime-2.1 (USD / 1M tokens)
CALL_METRICS_PRICE_RT_AUDIO_IN_PER_1M=32
CALL_METRICS_PRICE_RT_AUDIO_OUT_PER_1M=64
CALL_METRICS_PRICE_RT_TEXT_IN_PER_1M=4
CALL_METRICS_PRICE_RT_TEXT_OUT_PER_1M=24
CALL_METRICS_PRICE_RT_AUDIO_CACHED_IN_PER_1M=0.40
CALL_METRICS_PRICE_RT_TEXT_CACHED_IN_PER_1M=0.40
CALL_METRICS_PRICE_RT_TRANSCRIBE_PER_MINUTE=0.003

# --- ElevenLabs TTS (TTS_PROVIDER=elevenlabs) ---
ELEVENLABS_API_KEY=
#ELEVENLABS_VOICE_ID=h60rOzgfLmYsntfqgGu2
ELEVENLABS_VOICE_ID=9rvdnhrYoXoUt4igKpBw
ELEVENLABS_SPEED=1.10
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2



